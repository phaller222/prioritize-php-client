<?xml version="1.0" encoding="UTF-8"?>
<!--
    This pom.xml is NOT part of the published PHP package — Packagist ignores it.
    It is only the code-generation harness: it runs the OpenAPI Generator in `php`
    mode against the frozen openapi/openapi.json and writes the Composer package
    (composer.json, src/, docs/) into the repo root. The generated PHP is never
    hand-edited; to update the client, replace openapi/openapi.json with the next
    released spec and run `./generate.sh` (or `mvn generate-sources`).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.hallerweb</groupId>
    <artifactId>prioritize-php-client-codegen</artifactId>
    <version>1.3.0</version>
    <packaging>pom</packaging>

    <properties>
        <openapi-generator.version>7.10.0</openapi-generator.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>generate-prioritize-php-client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/openapi/openapi.json</inputSpec>
                            <output>${project.basedir}</output>
                            <generatorName>php</generatorName>
                            <invokerPackage>Hallerweb\Prioritize\Client</invokerPackage>
                            <apiPackage>Api</apiPackage>
                            <modelPackage>Model</modelPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>true</generateApiDocumentation>
                            <generateModelDocumentation>true</generateModelDocumentation>
                            <configOptions>
                                <composerVendorName>hallerweb</composerVendorName>
                                <composerProjectName>prioritize-php-client</composerProjectName>
                                <artifactVersion>1.3.0</artifactVersion>
                                <srcBasePath>src</srcBasePath>
                                <licenseName>Apache-2.0</licenseName>
                                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
